[run]
# Coverage scope: focus on the unit-testable core library modules.
source =
    patspeak

# Omit tests + glue modules that aren't practical to unit-test.
omit =
    */tests/*
    *\\tests\\*

    # Hardware / UI / integration layers
    */patspeak/can.py
    *\\patspeak\\can.py
    */patspeak/pcan_interface.py
    *\\patspeak\\pcan_interface.py
    */patspeak/progress.py
    *\\patspeak\\progress.py

    # Runner / filesystem glue (covered by integration/system tests, not unit tests)
    */patspeak/script.py
    *\\patspeak\\script.py
    */patspeak/runtime.py
    *\\patspeak\\runtime.py
    */patspeak/cli.py
    *\\patspeak\\cli.py
    */patspeak/paths.py
    *\\patspeak\\paths.py
    */patspeak/__main__.py
    *\\patspeak\\__main__.py

[report]
show_missing = True
skip_covered = True

# Keep report output consistent with [run].
omit =
    */tests/*
    *\\tests\\*
    */patspeak/can.py
    *\\patspeak\\can.py
    */patspeak/pcan_interface.py
    *\\patspeak\\pcan_interface.py
    */patspeak/progress.py
    *\\patspeak\\progress.py
    */patspeak/script.py
    *\\patspeak\\script.py
    */patspeak/runtime.py
    *\\patspeak\\runtime.py
    */patspeak/cli.py
    *\\patspeak\\cli.py
    */patspeak/paths.py
    *\\patspeak\\paths.py
    */patspeak/__main__.py
    *\\patspeak\\__main__.py
