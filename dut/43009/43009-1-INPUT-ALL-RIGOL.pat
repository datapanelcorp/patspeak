#43009-1
#Version 0.1
#input test (Rigol DP800 precision sweep)
UUT_DBC = 43009-560.dbc
UUT_DATANAME = 43009-1-INPUT-ALL-RIGOL

#cycle IGN to clean slate
RLY_K1 = 0 : NULL : WAIT = 1
RLY_K1 = 1 : NULL : WAIT = 2
RLY_K1 = 0 : NULL : WAIT = 1

#-----setup pat-----
#setup meter
LdRemote = 1 : NULL : WAIT = 0.1
LdCurrentSet = 0 : NULL : WAIT = 0.1
LdEnable = 0 : NULL : WAIT = 0.1
J0_08_METER_LOAD = 1 : NULL : WAIT = 1

#ensure PAT bench supply path is off (Rigol DP800 drives input sweep)
PwrRemote = 1 : NULL : WAIT = 0.1
PwrSetCurrent = 0 : NULL : WAIT = 0.1
PwrSetVoltage = 0 : NULL : WAIT = 0.1
PwrEnable = 0 : NULL : WAIT = 0.1
J0_09_TEST_SUPPLY = 0 : NULL : WAIT = 1

#force Rigol to known-safe state before routing
PAT dp800/rigol_dp800_set_ch.py --resource TCPIP0::192.168.45.178::INSTR --channel 2 --voltage 0.00 --current 1.000 --output off --settle 0.050 --retries 8 --retry-delay 0.500

#keep PAT test-supply relay off; Rigol is routed via J4_01
J0_09_TEST_SUPPLY = 0 : NULL : WAIT = 0.2

#switch in o-scope and keep Rigol route open only during each port sweep
J4_03 = 1 : NULL : WAIT = 0.2
J4_01 = 0 : NULL : WAIT = 0.1

#force CTRL1 command 0 request frame so STAT has a transmit trigger
#probe command-byte encoding with controller SA=0xD1
SEND_CAN CH0 0x18EFD9D1 0 0 0 0 0 0 0 0
Command = 0 : NULL : WAIT = 0.5
NULL : Response = 0 | 0.1 | 0.3
NULL : Software_Version = 0 | 255 | 0.3
NULL : Software_Revision = 0 | 255 | 0.3

#-----setup 43009-----
Command = 1, Enable_DIGIN = 1, Enable_AD2 = 1, Enable_AD3 = 1, Enable_AD4 = 1, Enable_DPLF2 = 1, Enable_FAULT = 1 : NULL : WAIT = 0.5

#switch input to load line and route Rigol DP800 source
J1_01 = 1 : NULL : WAIT = 0.1
J4_01 = 1 : NULL : WAIT = 0.1

#verify source is 0.00V before starting this input sweep
PAT dp800/rigol_dp800_set_ch.py --resource TCPIP0::192.168.45.178::INSTR --channel 2 --voltage 0.00 --current 1.000 --output on --settle 0.050 --retries 8 --retry-delay 0.500
NULL : MeterVolts = 0.00 | 0.050 | 0.1
NULL : Port_1A = 0.00 | 0.050 | 0.1
NULL : Input_1A = 0 | 0.1 | 0.1
#request WheelBrakeLiningRemaining PGN (FEAC) using SEND_CAN CH0
SEND_CAN CH0 0x18EAFFD1 172 254 0 0 0 0 0 0

#Sweep of Port_1A from 0.00 to 5.60 in 0.01 increments using Rigol DP800
PAT dp800/rigol_dp800_set_ch.py --resource TCPIP0::192.168.45.178::INSTR --channel 2 --voltage 0.00 --current 1.000 --output on --settle 0.015 --retries 8 --retry-delay 0.500
SEND_CAN CH0 0x18EAFFD1 172 254 0 0 0 0 0 0
NULL : MeterVolts = 0.00 | 0.050 | 0.1
NULL : Port_1A = 0.00 | 0.050 | 0.1
NULL : Input_1A = 0 | 0.1 | 0.1
PAT dp800/rigol_dp800_set_ch.py --resource TCPIP0::192.168.45.178::INSTR --channel 2 --voltage 0.01 --current 1.000 --output on --settle 0.015 --retries 8 --retry-delay 0.500
SEND_CAN CH0 0x18EAFFD1 172 254 0 0 0 0 0 0
NULL : MeterVolts = 0.01 | 0.050 | 0.1
NULL : Port_1A = 0.01 | 0.050 | 0.1
NULL : Input_1A = 0 | 0.1 | 0.1
