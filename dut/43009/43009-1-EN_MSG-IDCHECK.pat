#43009-1
#Version 0.2
#message enable/disable independence validation (ID-specific)
UUT_DBC = 43009-560.dbc
UUT_DATANAME = 43009-1-EN_MSG-IDCHECK

# Frame IDs under test (43009-560.dbc)
# DIGIN  = 0x98FF15D9
# AD2    = 0x98FF16D9
# AD3    = 0x98FF17D9
# AD4    = 0x98FF18D9
# DPLF2  = 0x98FFFCD9
# FAULT  = 0x98FFE6D9

#cycle IGN to clean slate
RLY_K1 = 0 : NULL : WAIT = 1
RLY_K1 = 1 : NULL : WAIT = 2
RLY_K1 = 0 : NULL : WAIT = 1

#start from all-target-messages disabled
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_NOT_ID 0x98FF15D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF16D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF17D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF18D9 1.2
UUT_TXCHECK_NOT_ID 0x98FFFCD9 1.2
UUT_TXCHECK_NOT_ID 0x98FFE6D9 1.2

#-----Enable_DIGIN only-----
Command = 1, Enable_DIGIN = 1, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_ID 0x98FF15D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF16D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF17D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF18D9 1.2
UUT_TXCHECK_NOT_ID 0x98FFFCD9 1.2
UUT_TXCHECK_NOT_ID 0x98FFE6D9 1.2
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_NOT_ID 0x98FF15D9 1.2

#-----Enable_AD2 only-----
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 1, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_ID 0x98FF16D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF15D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF17D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF18D9 1.2
UUT_TXCHECK_NOT_ID 0x98FFFCD9 1.2
UUT_TXCHECK_NOT_ID 0x98FFE6D9 1.2
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_NOT_ID 0x98FF16D9 1.2

#-----Enable_AD3 only-----
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 1, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_ID 0x98FF17D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF15D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF16D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF18D9 1.2
UUT_TXCHECK_NOT_ID 0x98FFFCD9 1.2
UUT_TXCHECK_NOT_ID 0x98FFE6D9 1.2
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_NOT_ID 0x98FF17D9 1.2

#-----Enable_AD4 only-----
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 1, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_ID 0x98FF18D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF15D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF16D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF17D9 1.2
UUT_TXCHECK_NOT_ID 0x98FFFCD9 1.2
UUT_TXCHECK_NOT_ID 0x98FFE6D9 1.2
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_NOT_ID 0x98FF18D9 1.2

#-----Enable_DPLF2 only-----
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 1, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_ID 0x98FFFCD9 1.5
UUT_TXCHECK_NOT_ID 0x98FF15D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF16D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF17D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF18D9 1.2
UUT_TXCHECK_NOT_ID 0x98FFE6D9 1.2
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_NOT_ID 0x98FFFCD9 1.2

#-----Enable_FAULT only-----
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 1 : NULL : WAIT = 0.8
UUT_TXCHECK_ID 0x98FFE6D9 1.5
UUT_TXCHECK_NOT_ID 0x98FF15D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF16D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF17D9 1.2
UUT_TXCHECK_NOT_ID 0x98FF18D9 1.2
UUT_TXCHECK_NOT_ID 0x98FFFCD9 1.2
Command = 1, Enable_DIGIN = 0, Enable_AD2 = 0, Enable_AD3 = 0, Enable_AD4 = 0, Enable_DPLF2 = 0, Enable_FAULT = 0 : NULL : WAIT = 0.8
UUT_TXCHECK_NOT_ID 0x98FFE6D9 1.2

SAVE
END
