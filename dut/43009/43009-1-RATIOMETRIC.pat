#43009-1
#Version 0.3
#ratiometric AD2/AD3 validation: all inputs, 1.0V..5.0V in 0.1V steps
#AD4 Spwr telemetry is used as denominator reference window; no sensor-power switching
UUT_DBC = 43009-560.dbc
UUT_DATANAME = 43009-1-RATIOMETRIC

#cycle IGN to clean slate
RLY_K1 = 0 : NULL : WAIT = 1
RLY_K1 = 1 : NULL : WAIT = 2
RLY_K1 = 0 : NULL : WAIT = 1

#force CTRL1 command 0 request frame so STAT has a transmit trigger
SEND_CAN CH0 0x18EFD9D1 0 0 0 0 0 0 0 0
Command = 0 : NULL : WAIT = 0.5
NULL : Response = 0 | 0.1 | 0.3
NULL : Software_Version = 0 | 255 | 0.3
NULL : Software_Revision = 0 | 255 | 0.3

#-----setup PAT-----
LdRemote = 1 : NULL : WAIT = 0.1
LdEnable = 0 : NULL : WAIT = 0.1
LdCurrentSet = 0 : NULL : WAIT = 0.1
LdShort = 0 : NULL : WAIT = 0.1
J0_08_METER_LOAD = 1 : NULL : WAIT = 1

#use PAT bench supply as input source
PwrRemote = 1 : NULL : WAIT = 0.1
PwrSetCurrent = 100 : NULL : WAIT = 0.1
PwrSetVoltage = 10 : NULL : WAIT = 0.1
PwrEnable = 1 : NULL : WAIT = 0.1
J0_09_TEST_SUPPLY = 1 : NULL : WAIT = 0.5

#all input routes open before test
J1_01 = 0, J1_02 = 0, J1_03 = 0, J1_04 = 0, J1_05 = 0, J1_06 = 0, J1_07 = 0, J1_08 = 0 : NULL : WAIT = 0.2
#force all sensor-power connector routes open (never switched in this test)
J2_02 = 0, J2_04 = 0, J2_06 = 0, J2_08 = 0 : NULL : WAIT = 0.2

#restore telemetry enables and latch ratio mode ON
Command = 1, Enable_DIGIN = 1, Enable_AD2 = 1, Enable_AD3 = 1, Enable_AD4 = 1, Enable_DPLF2 = 1, Enable_FAULT = 1, Ratiometric_AD2_AD3 = 1, Reset_Sensor_Power_Faults = 0 : NULL : WAIT = 0.50
#clear any pre-existing sensor-power latch from prior interrupted runs
Command = 1, Enable_DIGIN = 1, Enable_AD2 = 1, Enable_AD3 = 1, Enable_AD4 = 1, Enable_DPLF2 = 1, Enable_FAULT = 1, Ratiometric_AD2_AD3 = 1, Reset_Sensor_Power_Faults = 1 : NULL : WAIT = 0.50
Command = 1, Enable_DIGIN = 1, Enable_AD2 = 1, Enable_AD3 = 1, Enable_AD4 = 1, Enable_DPLF2 = 1, Enable_FAULT = 1, Ratiometric_AD2_AD3 = 1, Reset_Sensor_Power_Faults = 0 : NULL : WAIT = 0.50

